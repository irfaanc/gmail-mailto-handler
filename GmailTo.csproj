<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GmailTo</AssemblyName>
    <RootNamespace>GmailTo</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>gmailto</Product>
    <AssemblyTitle>gmailto</AssemblyTitle>
    <Company>Irfaan Chaudhry</Company>
    <Copyright>Copyright (c) 2026 Irfaan Chaudhry</Copyright>
    <PackageProjectUrl>https://github.com/irfaanc/gmailto</PackageProjectUrl>
    <RepositoryUrl>https://github.com/irfaanc/gmailto</RepositoryUrl>

    <!-- Publish as one file. GmailTo.exe on its own is only the launcher:
         the program lives in the .dll and the runtime version in the
         .runtimeconfig.json, so copying just the exe produces a launcher that
         fails before it can say anything, silently, because a WinExe has no
         console to print to. Bundling removes the chance to copy it wrong.
         Still framework-dependent, so it needs the .NET 8 desktop runtime. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!-- x86 by default, which is the build that runs everywhere: natively on
         32-bit Windows, under WOW64 on 64-bit, and under emulation on ARM64
         including Windows 10, where x64 emulation does not exist. Pass
         -r win-x64 for the 64-bit build. Single-file publishing requires some
         RuntimeIdentifier, so one has to be the default. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>

    <!-- Embedded in the exe, which is also what the DefaultIcon registry entry
         points at ("<exe>,0"), so Explorer, the taskbar and the Default apps
         list all take it from the one place. -->
    <ApplicationIcon>ico\app.ico</ApplicationIcon>

    <!-- Drives the generated ApplicationConfiguration.Initialize(). PerMonitorV2
         is what lets a window re-scale when dragged to a different-DPI monitor
         instead of being bitmap-stretched. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also carried as a resource so the windows can show it at whatever size
         they need. Reading it back off disk would not survive single-file
         publishing, where there is no file beside the exe to read. -->
    <EmbeddedResource Include="ico\app.ico" LogicalName="GmailTo.app.ico" />
  </ItemGroup>

</Project>
